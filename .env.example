# For a new setup, copy this file to .env and fill keys locally.
# If you already have .env, merge the new sections; preserve your existing keys.
# Never commit the real .env file or API keys.

# Default for the Python provider factory and initial React provider selection.
# Options: groq, gemini, fireworks, sail. Select explicitly in analysis controls.
# Sail / GLM-5.3 is the calibrated workspace default. Legacy Streamlit supports Groq/Gemini.
MODEL_PROVIDER=sail

# GroqCloud
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# Groq adapter defaults. Customer-spec analysis forces temperature 0 and no retries.
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
GROQ_MAX_COMPLETION_TOKENS=6000
GROQ_REASONING_EFFORT=none
GROQ_TEMPERATURE=0.7
GROQ_STRICT_STRUCTURED_OUTPUT=true

# Google Gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Set a compatible model available to your Google project.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=0
# Adapter default; customer-spec analysis uses SCIONE_CUSTOMER_GEMINI_OUTPUT_TOKENS below.
GEMINI_MAX_OUTPUT_TOKENS=6000
GEMINI_TEMPERATURE=0.0
GEMINI_THINKING_LEVEL=low

# Fireworks serverless inference: create an API key in the Fireworks dashboard.
# No dedicated model deployment or local GPU is needed. Blank keys disable it in UI.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash-1017
# Optional higher-cost comparison model: accounts/fireworks/models/kimi-k3p1-pro
FIREWORKS_TIMEOUT_SECONDS=90
FIREWORKS_MAX_OUTPUT_TOKENS=8192
FIREWORKS_TEMPERATURE=0.0
# Unset: verified DeepSeek V4.1 Flash models use none; other models keep vendor defaults.
# Optional explicit override, only if the chosen model supports it:
# FIREWORKS_REASONING_EFFORT=low

# Sail synchronous inference: create an API key at app.sailresearch.com.
# Uses ASAP requests. Flex-only models need a separate background/batch workflow.
SAIL_API_KEY=
SAIL_MODEL=zai-org/GLM-5.3
# Optional comparison model: moonshotai/Kimi-K3.1-Pro
SAIL_TIMEOUT_SECONDS=90
SAIL_MAX_OUTPUT_TOKENS=8192
SAIL_TEMPERATURE=0.0

# Safety guard for local experiments. When true, provider adapters make no
# automatic retry after a failed request. This does not inspect Google billing
# or guarantee zero cost; API usage follows the project's actual billing setup.
# Fireworks/Sail adapters always make one attempt, with no automatic retries.
SCIONE_SINGLE_ATTEMPT_MODE=true

# Workspace for source artifacts and embedded SQL development storage.
SCIONE_WORKSPACE_DIR=local_data

# MySQL setup: uv run python scripts/setup_database.py
# This writes a separate, ignored .env.database with generated local credentials.
# The application reads both .env and .env.database. Never paste credentials here.
# Without SCIONE_DATABASE_URL, the archive uses local_data/library.sqlite3.

# Customer extraction guard: document + prompt + schema characters, not token quota.
SCIONE_CUSTOMER_INPUT_CHARACTER_LIMIT=60000
# Default Gemini output ceiling in the customer-spec analysis controls.
# Not an account quota or spending cap. Used only after explicit consent to run.
SCIONE_CUSTOMER_GEMINI_OUTPUT_TOKENS=16000

# Semantic matching guard: prompt + candidate snapshot + schema characters.
# Explicit matching uses its own saved run; browsing does not call a model.
# This is neither a token quota nor a monetary spending cap.
SCIONE_MATCHING_INPUT_CHARACTER_LIMIT=120000
