# For a new setup, copy this file to .env and fill keys locally.
# If you already have .env, merge the new sections; preserve your existing keys.
# Never commit the real .env file or API keys.

# Server-selected provider for ordinary lab analysis and report generation.
# Options: groq, gemini, fireworks, sail. Maintainers can run model experiments.
# Sail / GLM-5.3 is the configured baseline; this is not an accuracy guarantee.
# Legacy Streamlit supports Groq/Gemini.
MODEL_PROVIDER=sail

# GroqCloud
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Groq adapter defaults. Customer-spec analysis forces temperature 0 and no retries.
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
GROQ_MAX_COMPLETION_TOKENS=6000
GROQ_REASONING_EFFORT=none
GROQ_TEMPERATURE=0.7
GROQ_STRICT_STRUCTURED_OUTPUT=true

# Google Gemini
GEMINI_API_KEY=
# Set a compatible model available to your Google project.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=0
# Adapter default; customer-spec analysis uses SCIONE_CUSTOMER_GEMINI_OUTPUT_TOKENS below.
GEMINI_MAX_OUTPUT_TOKENS=6000
GEMINI_TEMPERATURE=0.0
GEMINI_THINKING_LEVEL=low

# Fireworks serverless inference: create an API key in the Fireworks dashboard.
# No dedicated model deployment or local GPU is needed. Blank keys disable this adapter.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash-1017
# Optional higher-cost comparison model: accounts/fireworks/models/kimi-k3p1-pro
FIREWORKS_TIMEOUT_SECONDS=90
FIREWORKS_MAX_OUTPUT_TOKENS=8192
FIREWORKS_TEMPERATURE=0.0
# Unset: verified DeepSeek V4.1 Flash models use none; other models keep vendor defaults.
# Optional explicit override, only if the chosen model supports it:
# FIREWORKS_REASONING_EFFORT=low
# Same GLM-5.3 baseline through Fireworks (operator-selected, no automatic fallback):
# MODEL_PROVIDER=fireworks
# FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3
# FIREWORKS_REASONING_EFFORT=low
# FIREWORKS_TIMEOUT_SECONDS=300
# FIREWORKS_MAX_OUTPUT_TOKENS=12288

# Sail synchronous inference: create an API key at app.sailresearch.com.
# Uses ASAP requests. Flex-only models need a separate background/batch workflow.
SAIL_API_KEY=
SAIL_MODEL=zai-org/GLM-5.3
# Optional comparison model: moonshotai/Kimi-K3.1-Pro
# Finite per-request deadline; long-document concurrency is configured below.
# A provider timeout is retained as a failed attempt, without automatic retries.
SAIL_TIMEOUT_SECONDS=300
SAIL_MAX_OUTPUT_TOKENS=12288
SAIL_TEMPERATURE=0.0

# Safety guard for local experiments. When true, provider adapters make no
# automatic retry after a failed request. This does not inspect Google billing
# or guarantee zero cost; API usage follows the project's actual billing setup.
# Fireworks/Sail adapters always make one attempt, with no automatic retries.
SCIONE_SINGLE_ATTEMPT_MODE=true

# Legacy development workspace. scripts/serve_trial.py uses its own isolated
# local_data/trial-preview storage and enables real login automatically.
# Do not expose the default unauthenticated scione serve mode to the internet.
SCIONE_WORKSPACE_DIR=local_data

# Hosted authentication: configure these as server environment variables, not in Git.
# The Docker entrypoint enables authentication and requires HTTPS + managed MySQL.
# See docs/deployment/railway.md for account provisioning and persistent storage.
# Keep one application replica and one worker during this pilot.
# SCIONE_ENVIRONMENT=production
# SCIONE_AUTH_ENABLED=true
# SCIONE_PUBLIC_URL=https://your-app.example
# SCIONE_ALLOWED_HOSTS=["your-app.example","healthcheck.railway.app","localhost","127.0.0.1"]
# SCIONE_TRUSTED_ORIGINS=[]
# SCIONE_COOKIE_SECURE=true
# SCIONE_WORKSPACE_DIR=/data

# Optional session/login limits; the defaults below are already applied.
# SCIONE_AUTH_SESSION_HOURS=12
# SCIONE_AUTH_IDLE_MINUTES=60
# SCIONE_AUTH_LOGIN_WINDOW_SECONDS=900
# SCIONE_AUTH_LOGIN_USER_LIMIT=8
# SCIONE_AUTH_LOGIN_IP_LIMIT=40

# Account/session storage defaults to SCIONE_DATABASE_URL when configured.
# Lab business data uses separate MySQL schemas, or separate files in local preview.
# Keep connection URLs and generated account passwords in private server settings.
# SCIONE_DATABASE_URL=
# SCIONE_AUTH_DATABASE_URL=
# Initial hosted accounts use private SCIONE_BOOTSTRAP_ACCOUNTS JSON; follow the
# deployment guide or scione accounts commands. No default passwords are shipped.

# MySQL setup: uv run python scripts/setup_database.py
# This writes a separate, ignored .env.database with generated local credentials.
# The application reads both .env and .env.database. Never paste credentials here.
# Without SCIONE_DATABASE_URL, legacy development uses local_data/library.sqlite3.
# The authenticated preview keeps one embedded business database per lab.

# Customer extraction guard: document + prompt + schema characters, not token quota.
SCIONE_CUSTOMER_INPUT_CHARACTER_LIMIT=60000
# Default Gemini output ceiling in the customer-spec analysis controls.
# Not an account quota or spending cap. Analyze PDF starts model use; browsing does not.
SCIONE_CUSTOMER_GEMINI_OUTPUT_TOKENS=16000

# Semantic matching guard: prompt + candidate snapshot + schema characters.
# Generate report uses a saved matching run; browsing does not call a model.
# This is neither a token quota nor a monetary spending cap.
SCIONE_MATCHING_INPUT_CHARACTER_LIMIT=120000

# PDFs longer than 10 pages: maximum simultaneous Sail/Fireworks extraction
# chunks or matching batches. Default 4, allowed 1-4; lower to 1 or 2 if rate-limited.
# Fitting-source inventory/extraction stays serial; shorter matching batches
# retain their existing two-call limit. Other providers remain sequential.
# This changes wave width, not the planned call cap, retries or spending limits.
SCIONE_LONG_DOCUMENT_PARALLELISM=4
