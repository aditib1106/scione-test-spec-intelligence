# Copy this file to .env and replace placeholder values locally.
# Never commit the real .env file or API keys.

# Initial provider selected in the customer-spec analysis controls.
MODEL_PROVIDER=groq

# GroqCloud
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# Groq request behavior
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
GROQ_MAX_COMPLETION_TOKENS=6000
GROQ_REASONING_EFFORT=none
GROQ_TEMPERATURE=0.7
GROQ_STRICT_STRUCTURED_OUTPUT=true

# Google Gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Set a compatible model available to your Google project.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=0
GEMINI_MAX_OUTPUT_TOKENS=6000
GEMINI_TEMPERATURE=0.0
GEMINI_THINKING_LEVEL=low

# Safety guard for local experiments. When true, provider adapters make no
# automatic retry after a failed request. This does not inspect Google billing;
# confirm that the project itself remains on the Free tier in AI Studio.
SCIONE_SINGLE_ATTEMPT_MODE=true

# Editable demo-lab data; local files only, no database setup required.
SCIONE_WORKSPACE_DIR=local_data

# Customer extraction guard: document + prompt + schema characters, not token quota.
SCIONE_CUSTOMER_INPUT_CHARACTER_LIMIT=60000
# Customer-spec output ceiling only; the 13-page sample exceeded 6000 tokens.
# Not an account quota or spending cap. Used only after explicit consent to run.
SCIONE_CUSTOMER_GEMINI_OUTPUT_TOKENS=16000
